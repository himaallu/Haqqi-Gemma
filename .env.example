# Copy to .env and fill in. Never commit .env.

# LLM: gemini (default) or k2 is tried first; the other is the fallback.
# Default model: open-weight Gemma 4, served by Google's Gemini API (OpenAI-compatible endpoint).
# Key from https://aistudio.google.com/apikey. Free-tier requests may be used
# by Google to improve its products (flag 26).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemma-4-26b-a4b-it
# Models tried in order when the primary hits its per-model quota, before K2. Empty: Gemma 4 26B only
# (31B was dropped on 30 Oct: it returned 500s and timed out on every step).
# The Gemini Flash models also work here, e.g. gemini-3-flash-preview,gemini-3.5-flash.
GEMINI_FALLBACK_MODELS=
# Free-tier requests per day per Gemini model, for the demo's "free calls left" estimate
GEMINI_DAILY_LIMIT_PER_MODEL=20

# K2 Horizon hosted API (OpenAI-compatible). Leave the key empty to run every step on Gemma.
K2_API_KEY=
K2_BASE_URL=https://api.ifm.ai/v1
K2_MODEL=IFM/K2-Horizon-375B-A23B

# Backup LLM + Whisper speech-to-text: Groq free tier (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Postgres + pgvector (docker-compose default below; Supabase URL in production)
DATABASE_URL=postgresql://haqqi:haqqi@localhost:5432/haqqi

# Text embedder for law search: cloudflare (BGE-M3 on Workers AI, free tier) or hash (offline stand-in).
# Run `make db` again after changing it: stored law vectors must come from the same embedder.
EMBEDDER=hash
CLOUDFLARE_ACCOUNT_ID=
# API token with the "Workers AI: Read" permission
CLOUDFLARE_API_TOKEN=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Optional: more allowed origins as one regex (the pitch demo on Lovable, docs/demo/LOVABLE_PROMPT.md)
CORS_ORIGIN_REGEX=

# Frontend: where the browser reaches the backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Test-only hooks (e.g. TC-11's seeded bad citation). Leave false outside tests.
HAQQI_TEST_HOOKS=false

# Demo replay: 1 makes the TC-02 story (Urdu, or the English /demo "Fired without notice" example) answer
# from a recorded Gemma 4 run (eval/demo/*.json) with no model call; routing, calculator, citation checks and the
# PDF still run live, and the results page says it is a replay. Any other story runs live. Off by default.
DEMO_REPLAY=0

# Langfuse tracing of LLM calls (task 8.2): stage, model, timing and tokens only, never content.
# Leave empty to turn tracing off. EU cloud: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
